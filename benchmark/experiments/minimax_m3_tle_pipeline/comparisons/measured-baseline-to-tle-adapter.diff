         "decode_policy=%s prefill_min_q=%d spec_bf16_qk=%s int8_fallback=%s", decode_on, prefill_on, arm,
         [(lim, a, c) for lim, a, c in DECODE_POLICY], PREFILL_MIN_Q, _SPEC_BF16_QK, _INT8_FALLBACK)
     return True
