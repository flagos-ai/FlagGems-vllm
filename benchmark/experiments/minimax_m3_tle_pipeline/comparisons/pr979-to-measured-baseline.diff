+class AttentionPrecisionPolicy(NamedTuple):
+    """Hardware facts, independent of cache dtype and allocation policy."""
+
+    device_id: int
+    vendor: str
+    capability: int | None
+    supports_fp8: bool
+    supports_int8: bool
+    evidence: str
+
+
+_PRECISION_POLICIES: dict = {}
+_INT8_FALLBACK = False
+_PRECISION_LOCKED = False
+
+
+def attention_precision_policy(device_id=0, *, platform=None):
+    """Probe the target platform lazily and cache hardware facts per device.
+
+    No device is probed at import. NVIDIA uses the actual target SM rather
+    than assuming that a CUDA tensor or an FP8 dtype implies FP8 hardware.
+    ``platform`` is an uncached injection point for CPU capability tests.
+    """
+    if platform is None:
+        platform = _current_platform
+        if platform is None:
+            from vllm.platforms import current_platform
+            platform = current_platform
+        key = (id(platform), int(device_id))
+        found = _PRECISION_POLICIES.get(key)
+        if found is not None:
+            return found
+    else:
+        key = None
+    raw_vendor = vars(platform).get("vendor_name")
+    if raw_vendor is None:
+        for cls in type(platform).__mro__:
+            if "vendor_name" in vars(cls):
+                raw_vendor = getattr(platform, "vendor_name", None)
+                break
+    vendor = str(raw_vendor or "").lower()
+    # In vLLM, is_cuda identifies PlatformEnum.CUDA (NVIDIA), not merely
+    # the existence of a CUDA-like runtime. The SM check remains mandatory.
+    is_nvidia = vendor == "nvidia" or (
+        not vendor and platform.is_cuda() and not platform.is_rocm())
+    capability = None
+    if is_nvidia:
+        cap = platform.get_device_capability(device_id)
+        if cap is None:
+            raise RuntimeError("Cannot determine NVIDIA attention device capability")
+        if hasattr(cap, "major"):
+            capability = int(cap.major) * 10 + int(cap.minor)
+        else:
+            capability = int(cap[0]) * 10 + int(cap[1])
+        vendor = "nvidia"
+        fp8 = capability >= 89
+        int8 = capability >= 80
+        evidence = "NVIDIA target get_device_capability"
+    else:
+        fp8 = bool(platform.supports_fp8())
+        int8 = False  # No other vendor's INT8 attend kernel is validated here.
+        evidence = "current_platform.supports_fp8"
+    policy = AttentionPrecisionPolicy(int(device_id), vendor, capability,
+                                      fp8, int8, evidence)
+    if key is not None:
+        _PRECISION_POLICIES[key] = policy
+    return policy
+
+
+def _require_fp8(device_id=0):
+    policy = attention_precision_policy(device_id)
+    if not policy.supports_fp8:
+        raise RuntimeError(
+            "FP8 attention requested on a device without FP8 support "
+            f"({policy.vendor}, SM{policy.capability}); select BF16 KV before "
+            "allocation and install_attn_tuned(int8_fallback=True)")
+
+
+def _qk_int8_mode(q, kv_cache, output, k_scale=None, v_scale=None,
+                  *, fp8_requested=False):
+    """Validate storage before dispatch; never reinterpret FP8 as INT8."""
+    global _PRECISION_LOCKED
+    if _INT8_FALLBACK:
+        if (q.device.type != "cuda" or q.dtype != torch.bfloat16
+                or output.dtype != torch.bfloat16 or output.shape != q.shape
+                or kv_cache.dtype != torch.bfloat16):
+            raise ValueError("INT8 QK attention requires BF16 Q/output and BF16 KV storage; "
+                             "FP8/uint8 caches must be rejected before reinterpretation")
+        if (q.ndim != 3 or kv_cache.ndim != 4 or q.shape[-1] not in (96, 128)
+                or kv_cache.shape[2:] != (128, 2*q.shape[-1])
+                or q.shape[1] != 8*kv_cache.shape[1]):
+            raise ValueError("INT8 QK attention supports D96/128, GQA8 and page128 packed KV")
+        if not ((k_scale is None and v_scale is None) or (
+                k_scale is not None and v_scale is not None
+                and k_scale.numel() == 1 and v_scale.numel() == 1)):
+            raise ValueError("INT8 QK attention supports no scales or paired scalar scales")
+        policy = attention_precision_policy(q.device.index or 0)
+        if not policy.supports_int8:
+            raise RuntimeError("INT8 QK attention requires verified NVIDIA SM80+ kernels")
+        _PRECISION_LOCKED = True
+        return True
+    if fp8_requested or str(kv_cache.dtype).startswith("torch.float8"):
+        _require_fp8(q.device.index or 0)
+    if kv_cache.dtype == torch.uint8:
+        raise ValueError("Direct attention kernels require typed BF16/FP8 KV, not raw uint8")
+    _PRECISION_LOCKED = True
+    return False
